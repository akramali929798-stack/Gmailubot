# Railway Environment Variables — Copy to Railway dashboard → Variables

# ─── Required ─────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ─── Admin IDs (comma-separated Telegram user IDs) ────────
ADMIN_IDS=123456789,987654321

# ─── Gmail + IMAP Passwords (JSON string) ─────────────────
# Format: {"email@gmail.com":"app_password","email2@gmail.com":"app_password2"}
IMAP_PASSWORDS={"email@gmail.com":"xxxx xxxx xxxx xxxx"}

# ─── Optional: separate group bot ─────────────────────────
GROUP_ID=-1001234567890
# GROUP_TOKEN=another_bot_token  # leave empty to reuse BOT_TOKEN
